  "parallax": {
    "_": "Share of the camera move per layer, starting values from docs/cyber/2026-11-19-animation-research.md. Lines, HUD and CTA take the parallax shift only, never the camera scale.",
    "sky": 0.05,
    "far": 0.15,
    "mid": 0.4,
    "character": 1.0,
    "foreground": [
      1.3,
      1.6
    ],
    "far_blur_px": [
      1.5,
      3
    ],
    "push_scale": [
      1.06,
      1.1
    ],
