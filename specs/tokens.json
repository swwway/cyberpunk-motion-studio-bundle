  "motion": {
    "walk_100style": {
      "_": "100STYLE HandsInPockets_FW (Ian Mason, CC BY 4.0): data/motion/100style/, analysis scripts/series/bvh_analyze.py. Amplitudes are half peak-to-peak in % of body height; per-frame curves: HandsInPockets_FW_gait.json -> perframe (60 fps, 3.47 s).",
      "steps_per_s": 1.5,
      "step_frames": 20,
      "stride_frames": 40,
      "bob_pct_height": 1.0,
      "sway_pct_height": 1.6,
      "head_pitch_deg": 3.8,
      "head_roll_deg": 2.6,
      "shoulder_roll_deg": 3.6,
      "speed_pct_height_per_s": 54,
      "credit_ru": "Движение: 100STYLE Dataset — Ian Mason (CC BY 4.0)"
    }
  },
  "shot_types": {
    "_": "Bible §5. Each type is a 3 s probe (probe_frames) the owner approves once; then it is reused from episode to episode.",
    "probe_frames": 90,
    "1": "boots",
    "2": "profile_walk",
    "3": "two_waist_up",
    "4": "hand",
    "5": "dive",
    "6": "reaction",
    "7": "far_silhouette",
    "8": "cta"
  },
  "audio_mix": {
    "_": "For the future voice; the pilot has none. whiplash_music_mute_ms: the hard music cut before the hero's barb.",
    "master_dialogue_lufs": -14.0,
    "true_peak_dbtp": -1.0,
    "music_duck_db": -12.0,
    "beat_relative_gain_db": {
