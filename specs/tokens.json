{
  "meta": {
    "studio": "Faceted Neo-Cyberpunk Motion Studio",
    "version": "2.0",
    "format": "9:16",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "stepped_character_fps": 15,
    "language": "ru-RU"
  },
  "stepping": {
    "_": "meta.stepped_character_fps = 15: these parts hold each pose 2 frames (on twos) and start on even frames; everything else moves every frame at 30 fps.",
    "on_twos": [
      "legs",
      "boot_steps",
      "mouth_visemes",
      "eyelids",
      "hand_shapes"
    ],
    "on_ones": [
      "coat",
      "hair",
      "camera",
      "parallax",
      "fx",
      "text"
    ],
    "key_pose_hold_frames": [
      2,
      3
    ],
    "coat_lag_frames": [
      3,
      4
    ]
  },
  "safe_zones": {
    "x_min_px": 108,
    "x_max_px": 907,
    "y_min_px": 384,
    "y_max_px": 1382,
    "x_pct": [
      10,
      84
    ],
    "y_pct": [
      20,
      72
    ]
  },
  "rig_canvas": {
    "_": "v1 bust canvas 700x800, never built; the rig in use is rig_body. jaw_drop_max_px is the one jaw number: 5 px here = SHAPES.AI.open 0.12 of mouth width in src/cyber/faceRig.ts.",
    "viewBox": "0 0 700 800",
    "proportions": {
      "shoulder_to_head_width_ratio": 3.2,
      "shoulder_corner_style": "razor_sharp_angular"
    },
    "anchors": {
      "head_pivot": [
        350,
        345
      ],
      "neck_pivot": [
        350,
        395
      ],
      "shoulder_left_corner": [
        95,
        455
      ],
      "shoulder_right_corner": [
        605,
        455
      ],
      "eye_center_y": 235,
      "left_eye_x": 312,
      "right_eye_x": 388,
      "mouth_pivot": [
        350,
        310
      ],
      "jaw_drop_max_px": 5
    }
  },
  "rig_body": {
    "_": "src/cyber/rig/body.ts: units of body height 1600, sole at y 1600, x 0 = pelvis axis. Targets from bible §2 (Proko/Loomis, not checked on a render); shoulder width stays as drawn and becomes ≈1.9 head heights. interlocutor_facets_start is a starting value, not approved.",
    "height_units": 1600,
    "heads_target": 8.5,
    "head_scale_from": 0.38,
    "head_scale_target": 0.295,
    "arm_shorten_pct": [
      8,
      10
